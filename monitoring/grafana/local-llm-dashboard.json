{
  "title": "Local LLM Server",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "tags": ["local-llm", "ollama"],
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "title": "Requests per second",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "sum(rate(local_llm_requests_total[5m]))", "legendFormat": "requests/s"}]
    },
    {
      "title": "Error rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "sum(rate(local_llm_errors_total[5m])) / clamp_min(sum(rate(local_llm_requests_total[5m])), 1)", "legendFormat": "error ratio"}]
    },
    {
      "title": "P95 latency",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(local_llm_request_duration_seconds_bucket[5m])))", "legendFormat": "p95 seconds"}]
    },
    {
      "title": "Tokens by model",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{"expr": "sum by (model, type) (rate(local_llm_tokens_total[5m]))", "legendFormat": "{{model}} {{type}}"}]
    }
  ]
}
