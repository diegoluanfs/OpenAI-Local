APP_ENV=development
HOST=0.0.0.0
PORT=8000
OLLAMA_URL=http://ollama:11434
LMSTUDIO_URL=http://host.docker.internal:1234
PROVIDER_NAME=ollama
DEFAULT_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text
LOG_LEVEL=INFO
TIMEOUT_SECONDS=120
TIMEOUT_TAGS_SECONDS=10
TIMEOUT_CHAT_SECONDS=120
TIMEOUT_GENERATE_SECONDS=120
TIMEOUT_EMBEDDINGS_SECONDS=60
TIMEOUT_PULL_SECONDS=0
MODEL_CACHE_TTL_SECONDS=5
API_KEY=
API_KEY_FILE=
ALLOWED_API_KEYS=
ALLOWED_API_KEYS_FILE=
ALLOW_ANONYMOUS_REQUESTS=true
UNAUTH_RATE_LIMIT_PER_MINUTE=30
INFERENCE_CONCURRENCY_LIMIT=2
MAX_REQUEST_BODY_BYTES=1048576
HTTPX_MAX_CONNECTIONS=20
HTTPX_MAX_KEEPALIVE_CONNECTIONS=5
RATE_LIMIT_BACKEND=memory
REDIS_URL=
REDIS_KEY_PREFIX=local-llm:ratelimit
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=0
AUTO_PULL_DEFAULT_MODEL=true
